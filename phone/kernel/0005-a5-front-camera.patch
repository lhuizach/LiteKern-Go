 	};
 };
+
+/* LiteKern Go: the front camera, a Samsung S5K5E3YX (drivers/misc/s5k5e3yx.c): two lanes into the second
+ * CSI PHY, on the same camera bus as the rear one, its own clock (MCLK1) and pins, the same supplies. The pins
+ * and power-up order are from the stock device tree (camera@1). */
+&camss {
+	ports {
+		port@1 {
+			reg = <1>;
+
+			csiphy1_ep: endpoint {
+				data-lanes = <0 2>;
+				clock-lanes = <1>;
+				remote-endpoint = <&s5k5e3yx_ep>;
+			};
+		};
+	};
+};
+
+&cci_i2c0 {
+	camera@10 {
+		compatible = "samsung,s5k5e3yx";
+		reg = <0x10>;
+		clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;
+		vio-supply = <&pm8916_l16>;
+		vdig-supply = <&rt5033_buck>;
+		vana-supply = <&rt5033_ldo>;
+		enable-gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&front_camera_default>;
+
+		port {
+			s5k5e3yx_ep: endpoint {
+				data-lanes = <1 2>;
+				remote-endpoint = <&csiphy1_ep>;
+			};
+		};
+	};
+};
+
+&tlmm {
+	front_camera_default: front-camera-default-state {
+		mclk1-pins {
+			pins = "gpio27";
+			function = "cam_mclk1";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		control-pins {
+			pins = "gpio28", "gpio120";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
