-static int ea8061v_ams497ee01_on(struct ea8061v_ams497ee01 *ctx)
+/*
+ * Dimming. Samsung's own phones fine-tune a colour table for every brightness level, using
+ * calibration values stored in each panel; these tables are the generic ones, and on a real
+ * A5 every level but the brightest comes out tinted (yellow-green). So the colours are set
+ * once, at the brightest level, and the picture is dimmed only by how long each frame the
+ * panel is lit (AID, "impulsive driving"): that changes brightness and nothing else, and
+ * takes two short commands, where a full change took ten and made the picture break up.
+ *
+ * AID's value is how much of the frame the panel is dark, out of 1304 (0x0a: 0.8 %, the
+ * brightest; 0x4df: 95.6 %, the dimmest). The level (0 to 61) is spread over the lit time
+ * with a curve, so the steps look even to the eye.
+ */
+static unsigned int ea8061v_ams497ee01_aid_index(unsigned int level)
+{
+	unsigned int lit, want, i, best = 0, best_diff = ~0u;
+
+	if (level > EA8061V_AMS497EE01_MAX_BRIGHTNESS)
+		level = EA8061V_AMS497EE01_MAX_BRIGHTNESS;
+	/* lit time in 1/1024: 4.4 % at level 0, all of it at the top */
+	lit = 45 + 979 * level * level / (EA8061V_AMS497EE01_MAX_BRIGHTNESS * EA8061V_AMS497EE01_MAX_BRIGHTNESS);
+	want = 1304 * (1024 - lit) / 1024;
+	for (i = 0; i < EA8061V_AMS497EE01_NUM_AID_LEVELS; i++) {
+		unsigned int v = seq_ea8061v_ams497ee01_aid[i][3] << 8 | seq_ea8061v_ams497ee01_aid[i][4];
+		unsigned int diff = v > want ? v - want : want - v;
+
+		if (diff < best_diff) {
+			best_diff = diff;
+			best = i;
+		}
+	}
+	return best;
+}
+
+static int ea8061v_ams497ee01_update_aid(struct ea8061v_ams497ee01 *ctx,
+					 unsigned int brightness)
+{
+	int ret;
+	int index = ea8061v_ams497ee01_aid_index(brightness);
+
+	ret = mipi_dsi_dcs_write_buffer(ctx->dsi,
+					seq_ea8061v_ams497ee01_aid[index],
+					EA8061V_AMS497EE01_AID_CMD_CNT);
+	if (ret < 0)
+		return ret;
+	return 0;
+}
