diff -urN a/drivers/misc/imx135.c b/drivers/misc/imx135.c
--- a/drivers/misc/imx135.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/misc/imx135.c	2026-11-07 18:40:43.556474681 +0000
@@ -0,0 +1,358 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LiteKern Go: the Sony IMX135, the Galaxy A5 (2015)'s rear camera, as a V4L2
+ * sensor for Qualcomm's CAMSS. 1280x720, RAW10, four lanes; nothing else yet.
+ *
+ * The register table (imx135-modes.h) is NVIDIA's, from their GPL Tegra driver
+ * (Copyright (c) 2013, NVIDIA CORPORATION). Pins and supplies are from Samsung's
+ * kernel (msm8916-camera-sensor-cdp-a5u.dtsi, imx135.c).
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+
+#include "imx135-modes.h"
+
+/* The nearest the clock controller gets to 24 MHz: asking for that gives 66.67. */
+#define MCLK_HZ		23880000
+#define WIDTH		1280
+#define HEIGHT		720
+/* CSI-2 is double data rate: about 448 Mb/s on each of 4 lanes. */
+#define LINK_FREQ	223875000
+#define MBUS_CODE	MEDIA_BUS_FMT_SRGGB10_1X10
+#define EXPOSURE_MAX	2620		/* lines, at this frame length */
+#define GAIN_MAX	224		/* 8x: gain = 256 / (256 - code) */
+
+/*
+ * CAMSS sets its clocks from this. The sensor averages 180 MHz, which leaves the
+ * VFE at 50 MHz, and it overflows on the sensor's bursts: so it's told more.
+ * The PHY's timing comes from LINK_FREQ, which stays true.
+ */
+static long reported_rate = 1500000000;
+module_param(reported_rate, long, 0444);
+MODULE_PARM_DESC(reported_rate, "pixel rate told to CAMSS");
+static int pll = 450;
+module_param(pll, int, 0444);
+MODULE_PARM_DESC(pll, "PLL multiplier, 450 in the table");
+static int test_pattern;
+module_param(test_pattern, int, 0644);
+MODULE_PARM_DESC(test_pattern, "0 the camera, 2 colour bars");
+
+struct imx135 {
+	struct i2c_client *client;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *exposure, *gain;
+	struct clk *mclk;
+	struct regulator *vio, *vaf, *vdig, *vana;
+	struct gpio_desc *enable, *reset;
+	int on;
+};
+
+static int write8(struct imx135 *s, u16 reg, u8 val)
+{
+	u8 b[3] = { reg >> 8, reg & 0xff, val };
+	int ret = i2c_master_send(s->client, b, 3);
+
+	return ret == 3 ? 0 : (ret < 0 ? ret : -EIO);
+}
+
+static int read16(struct imx135 *s, u16 reg, u16 *val)
+{
+	u8 out[2] = { reg >> 8, reg & 0xff }, in[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = s->client->addr, .flags = 0, .len = 2, .buf = out },
+		{ .addr = s->client->addr, .flags = I2C_M_RD, .len = 2, .buf = in },
+	};
+	int ret = i2c_transfer(s->client->adapter, msgs, 2);
+
+	if (ret != 2)
+		return ret < 0 ? ret : -EIO;
+	*val = in[0] << 8 | in[1];
+	return 0;
+}
+
+static void power_off(struct imx135 *s)
+{
+	if (!s->on)
+		return;
+	s->on = 0;
+	gpiod_set_value_cansleep(s->reset, 0);
+	clk_disable_unprepare(s->mclk);
+	regulator_disable(s->vaf);
+	regulator_disable(s->vio);
+	gpiod_set_value_cansleep(s->enable, 0);
+	regulator_disable(s->vana);
+	regulator_disable(s->vdig);
+}
+
+static int power_on(struct imx135 *s)
+{
+	int err;
+
+	err = regulator_enable(s->vdig);
+	if (err)
+		return err;
+	err = regulator_enable(s->vana);
+	if (err)
+		goto no_vana;
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(s->enable, 1);
+	err = regulator_enable(s->vio);
+	if (err)
+		goto no_vio;
+	err = regulator_enable(s->vaf);
+	if (err)
+		goto no_vaf;
+	clk_set_rate(s->mclk, MCLK_HZ);
+	err = clk_prepare_enable(s->mclk);
+	if (err)
+		goto no_clk;
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(s->reset, 1);
+	msleep(30);
+	s->on = 1;
+	return 0;
+no_clk:
+	regulator_disable(s->vaf);
+no_vaf:
+	regulator_disable(s->vio);
+no_vio:
+	gpiod_set_value_cansleep(s->enable, 0);
+	regulator_disable(s->vana);
+no_vana:
+	regulator_disable(s->vdig);
+	return err;
+}
+
+static int write_mode(struct imx135 *s)
+{
+	for (const struct imx135_reg *r = mode_1280x720; r->addr != IMX135_TABLE_END; r++) {
+		int err;
+
+		if (r->addr == IMX135_TABLE_WAIT_MS) {
+			msleep(r->val);
+			continue;
+		}
+		if (r->addr == 0x0100) {	/* stream on: our changes first */
+			write8(s, 0x030c, pll >> 8);
+			write8(s, 0x030d, pll & 0xff);
+			write8(s, 0x0600, 0);
+			write8(s, 0x0601, test_pattern);
+			write8(s, 0x0202, s->exposure->val >> 8);
+			write8(s, 0x0203, s->exposure->val & 0xff);
+			write8(s, 0x0205, s->gain->val);
+		}
+		err = write8(s, r->addr, r->val);
+		if (err) {
+			dev_err(&s->client->dev, "write 0x%04x: %d\n", r->addr, err);
+			return err;
+		}
+	}
+	return 0;
+}
+
+static int imx135_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct imx135 *s = container_of(sd, struct imx135, sd);
+	u16 before = 0, after = 0;
+	int err;
+
+	if (!enable) {
+		power_off(s);
+		return 0;
+	}
+	err = power_on(s);
+	if (err)
+		return err;
+	err = write_mode(s);
+	if (!err) {
+		read16(s, 0x0004, &before);
+		msleep(120);
+		read16(s, 0x0004, &after);
+		dev_warn(&s->client->dev, "streaming: frame count %u then %u\n", before & 0xff, after & 0xff);
+		return 0;
+	}
+	power_off(s);
+	return err;
+}
+
+static int imx135_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx135 *s = container_of(ctrl->handler, struct imx135, ctrls);
+
+	if (!s->on)
+		return 0;			/* it goes in with the mode */
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		write8(s, 0x0104, 1);		/* both bytes together */
+		write8(s, 0x0202, ctrl->val >> 8);
+		write8(s, 0x0203, ctrl->val & 0xff);
+		return write8(s, 0x0104, 0);
+	case V4L2_CID_ANALOGUE_GAIN:
+		return write8(s, 0x0205, ctrl->val);
+	}
+	return -EINVAL;
+}
+
+static const struct v4l2_ctrl_ops ctrl_ops = {
+	.s_ctrl = imx135_s_ctrl,
+};
+
+static const s64 link_freqs[] = { LINK_FREQ };
+
+static void fill(struct v4l2_mbus_framefmt *f)
+{
+	memset(f, 0, sizeof(*f));
+	f->width = WIDTH;
+	f->height = HEIGHT;
+	f->code = MBUS_CODE;
+	f->field = V4L2_FIELD_NONE;
+	f->colorspace = V4L2_COLORSPACE_RAW;
+}
+
+static int imx135_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		      struct v4l2_subdev_format *fmt)
+{
+	fill(&fmt->format);
+	return 0;
+}
+
+static int imx135_enum_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MBUS_CODE;
+	return 0;
+}
+
+static int imx135_enum_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			    struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != MBUS_CODE)
+		return -EINVAL;
+	fse->min_width = fse->max_width = WIDTH;
+	fse->min_height = fse->max_height = HEIGHT;
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops video_ops = {
+	.s_stream = imx135_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops pad_ops = {
+	.enum_mbus_code = imx135_enum_code,
+	.enum_frame_size = imx135_enum_size,
+	.get_fmt = imx135_fmt,
+	.set_fmt = imx135_fmt,
+};
+
+static const struct v4l2_subdev_ops subdev_ops = {
+	.video = &video_ops,
+	.pad = &pad_ops,
+};
+
+static int get_supply(struct device *dev, struct regulator **r, const char *name)
+{
+	*r = devm_regulator_get(dev, name);
+	return IS_ERR(*r) ? dev_err_probe(dev, PTR_ERR(*r), "%s\n", name) : 0;
+}
+
+static int imx135_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx135 *s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	u16 id = 0;
+	int err;
+
+	if (!s)
+		return -ENOMEM;
+	s->client = client;
+	if ((err = get_supply(dev, &s->vio, "vio")) || (err = get_supply(dev, &s->vaf, "vaf")) ||
+	    (err = get_supply(dev, &s->vdig, "vdig")) || (err = get_supply(dev, &s->vana, "vana")))
+		return err;
+	s->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s->mclk))
+		return dev_err_probe(dev, PTR_ERR(s->mclk), "clock\n");
+	s->enable = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(s->enable))
+		return dev_err_probe(dev, PTR_ERR(s->enable), "enable\n");
+	s->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(s->reset))
+		return dev_err_probe(dev, PTR_ERR(s->reset), "reset\n");
+
+	err = power_on(s);
+	if (err)
+		return dev_err_probe(dev, err, "power\n");
+	err = read16(s, 0x0016, &id);
+	power_off(s);
+	if (err || id != 0x0135)
+		return dev_err_probe(dev, err ?: -ENODEV, "ID 0x%04x\n", id);
+	dev_warn(dev, "IMX135 found\n");
+
+	v4l2_i2c_subdev_init(&s->sd, client, &subdev_ops);
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	v4l2_ctrl_handler_init(&s->ctrls, 4);
+	s->exposure = v4l2_ctrl_new_std(&s->ctrls, &ctrl_ops, V4L2_CID_EXPOSURE, 1, EXPOSURE_MAX, 1, 1600);
+	s->gain = v4l2_ctrl_new_std(&s->ctrls, &ctrl_ops, V4L2_CID_ANALOGUE_GAIN, 0, GAIN_MAX, 1, 128);
+	v4l2_ctrl_new_std(&s->ctrls, NULL, V4L2_CID_PIXEL_RATE, reported_rate, reported_rate, 1, reported_rate);
+	v4l2_ctrl_new_int_menu(&s->ctrls, NULL, V4L2_CID_LINK_FREQ, 0, 0, link_freqs);
+	if (s->ctrls.error) {
+		err = s->ctrls.error;
+		goto no_ctrls;
+	}
+	s->sd.ctrl_handler = &s->ctrls;
+	err = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (err)
+		goto no_ctrls;
+	err = v4l2_async_register_subdev_sensor(&s->sd);
+	if (err)
+		goto no_async;
+	return 0;
+no_async:
+	media_entity_cleanup(&s->sd.entity);
+no_ctrls:
+	v4l2_ctrl_handler_free(&s->ctrls);
+	return err;
+}
+
+static void imx135_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx135 *s = container_of(sd, struct imx135, sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s->ctrls);
+	power_off(s);
+}
+
+static const struct of_device_id imx135_of[] = {
+	{ .compatible = "sony,imx135" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx135_of);
+
+static struct i2c_driver imx135_driver = {
+	.driver = {
+		.name = "imx135",
+		.of_match_table = imx135_of,
+	},
+	.probe = imx135_probe,
+	.remove = imx135_remove,
+};
+module_i2c_driver(imx135_driver);
+
+MODULE_DESCRIPTION("Sony IMX135 camera sensor, for LiteKern Go");
+MODULE_LICENSE("GPL");
