diff -urN a/drivers/misc/lkgo-camhello.c b/drivers/misc/lkgo-camhello.c
--- a/drivers/misc/lkgo-camhello.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/misc/lkgo-camhello.c	2026-11-07 17:40:44.402899469 +0000
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LiteKern Go: is anyone there? Powers each camera sensor of the Galaxy A5 (2015)
+ * in turn, reads its ID over the camera I2C bus, logs it and powers it off. No
+ * pictures: this only proves the wiring, before writing real sensor drivers.
+ *
+ * The rear IMX135 and the front S5K5E3YX share one bus and one address, so only
+ * one is ever out of reset. Pins and supplies are from Samsung's kernel
+ * (msm8916-camera-sensor-cdp-a5u.dtsi, imx135.c): the RT5033 PMIC gives the
+ * sensors their analog 2.8 V and the supply for their core.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#define MCLK_HZ 24000000
+
+struct hello {
+	struct i2c_client *client;
+	struct regulator *vio, *vaf, *vdig, *vana;
+};
+
+struct cam {
+	const char *name;
+	struct clk *mclk;
+	struct gpio_desc *enable, *reset;
+};
+
+static int read16(struct i2c_client *c, u16 addr, u16 reg, u16 *val)
+{
+	u8 out[2] = { reg >> 8, reg & 0xff }, in[2];
+	struct i2c_msg msgs[2] = {
+		{ .addr = addr, .flags = 0, .len = 2, .buf = out },
+		{ .addr = addr, .flags = I2C_M_RD, .len = 2, .buf = in },
+	};
+	int ret = i2c_transfer(c->adapter, msgs, 2);
+
+	if (ret != 2)
+		return ret < 0 ? ret : -EIO;
+	*val = in[0] << 8 | in[1];
+	return 0;
+}
+
+static void try_cam(struct hello *h, struct cam *cam)
+{
+	static const u16 addrs[] = { 0x10, 0x1a, 0x20, 0x2d, 0x36 };
+	struct device *dev = &h->client->dev;
+	int found = 0, err;
+
+	gpiod_set_value_cansleep(cam->enable, 1);
+	err = regulator_enable(h->vio);
+	if (err) {
+		dev_err(dev, "%s: 1.8 V supply: %d\n", cam->name, err);
+		goto no_vio;
+	}
+	err = regulator_enable(h->vaf);
+	if (err) {
+		dev_err(dev, "%s: 2.8 V supply: %d\n", cam->name, err);
+		goto no_vaf;
+	}
+	clk_set_rate(cam->mclk, MCLK_HZ);
+	err = clk_prepare_enable(cam->mclk);
+	if (err) {
+		dev_err(dev, "%s: clock: %d\n", cam->name, err);
+		goto no_clk;
+	}
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(cam->reset, 1);
+	msleep(30);
+
+	for (int i = 0; i < ARRAY_SIZE(addrs); i++) {
+		u16 at16 = 0, at0 = 0;
+		int e16 = read16(h->client, addrs[i], 0x0016, &at16);
+		int e0 = read16(h->client, addrs[i], 0x0000, &at0);
+
+		if (e16 && e0)
+			continue;
+		found = 1;
+		dev_warn(dev, "%s: answers at 0x%02x: reg 0x0016 = 0x%04x (%d), reg 0x0000 = 0x%04x (%d)\n",
+			 cam->name, addrs[i], at16, e16, at0, e0);
+	}
+	if (!found)
+		dev_warn(dev, "%s: no answer at any address\n", cam->name);
+
+	gpiod_set_value_cansleep(cam->reset, 0);
+	clk_disable_unprepare(cam->mclk);
+no_clk:
+	regulator_disable(h->vaf);
+no_vaf:
+	regulator_disable(h->vio);
+no_vio:
+	gpiod_set_value_cansleep(cam->enable, 0);
+}
+
+static int cam_get(struct device *dev, struct cam *cam, const char *name,
+		   const char *enable, const char *reset)
+{
+	cam->name = name;
+	cam->mclk = devm_clk_get(dev, name);
+	if (IS_ERR(cam->mclk))
+		return dev_err_probe(dev, PTR_ERR(cam->mclk), "%s clock\n", name);
+	cam->enable = devm_gpiod_get(dev, enable, GPIOD_OUT_LOW);
+	if (IS_ERR(cam->enable))
+		return dev_err_probe(dev, PTR_ERR(cam->enable), "%s enable\n", name);
+	cam->reset = devm_gpiod_get(dev, reset, GPIOD_OUT_LOW);
+	if (IS_ERR(cam->reset))
+		return dev_err_probe(dev, PTR_ERR(cam->reset), "%s reset\n", name);
+	return 0;
+}
+
+static int hello_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct hello *h = devm_kzalloc(dev, sizeof(*h), GFP_KERNEL);
+	struct cam rear, front;
+	int err;
+
+	if (!h)
+		return -ENOMEM;
+	h->client = client;
+	h->vio = devm_regulator_get(dev, "vio");
+	if (IS_ERR(h->vio))
+		return dev_err_probe(dev, PTR_ERR(h->vio), "vio\n");
+	h->vaf = devm_regulator_get(dev, "vaf");
+	if (IS_ERR(h->vaf))
+		return dev_err_probe(dev, PTR_ERR(h->vaf), "vaf\n");
+	h->vdig = devm_regulator_get(dev, "vdig");
+	if (IS_ERR(h->vdig))
+		return dev_err_probe(dev, PTR_ERR(h->vdig), "vdig\n");
+	h->vana = devm_regulator_get(dev, "vana");
+	if (IS_ERR(h->vana))
+		return dev_err_probe(dev, PTR_ERR(h->vana), "vana\n");
+	err = cam_get(dev, &rear, "rear", "rear-enable", "rear-reset");
+	if (err)
+		return err;
+	err = cam_get(dev, &front, "front", "front-enable", "front-reset");
+	if (err)
+		return err;
+	dev_warn(dev, "looking for the cameras\n");
+	err = regulator_enable(h->vdig);
+	if (err)
+		return dev_err_probe(dev, err, "core supply\n");
+	err = regulator_enable(h->vana);
+	if (err) {
+		regulator_disable(h->vdig);
+		return dev_err_probe(dev, err, "analog supply\n");
+	}
+	usleep_range(2000, 3000);
+	try_cam(h, &rear);
+	try_cam(h, &front);
+	regulator_disable(h->vana);
+	regulator_disable(h->vdig);
+	return 0;
+}
+
+static const struct of_device_id hello_of[] = {
+	{ .compatible = "litekern,cam-hello" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hello_of);
+
+static struct i2c_driver hello_driver = {
+	.driver = {
+		.name = "lkgo-camhello",
+		.of_match_table = hello_of,
+	},
+	.probe = hello_probe,
+};
+module_i2c_driver(hello_driver);
+
+MODULE_DESCRIPTION("LiteKern Go: reads the A5 camera sensors' IDs");
+MODULE_LICENSE("GPL");
