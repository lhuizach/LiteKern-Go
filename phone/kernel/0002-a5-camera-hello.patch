+};
+
+&cci_i2c0 {
+	camhello@10 {
+		compatible = "litekern,cam-hello";
+		reg = <0x10>;
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>, <&gcc GCC_CAMSS_MCLK1_CLK>;
+		clock-names = "rear", "front";
+		vio-supply = <&pm8916_l16>;
+		vaf-supply = <&pm8916_l10>;
+		vdig-supply = <&rt5033_buck>;
+		vana-supply = <&rt5033_ldo>;
+		rear-enable-gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
+		rear-reset-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+		front-enable-gpios = <&tlmm 120 GPIO_ACTIVE_HIGH>;
+		front-reset-gpios = <&tlmm 28 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&camhello_default>;
+	};
+};
+
+&tlmm {
+	camhello_default: camhello-default-state {
+		mclk0-pins {
+			pins = "gpio26";
+			function = "cam_mclk0";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		mclk1-pins {
+			pins = "gpio27";
+			function = "cam_mclk1";
+			drive-strength = <16>;
+			bias-disable;
+		};
+
+		control-pins {
+			pins = "gpio28", "gpio33", "gpio35", "gpio120";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
