# LiteKern X on Linux — lkx-shell, the desktop as a Linux program (phase L1).
#
#   wsl make -f platform/Makefile           build build-linux/lkx-shell
#   wsl make -f platform/Makefile run       open it in a window (WSLg)
#   wsl make -f platform/Makefile SELFTEST=wm LBUILD=build-linux/selftest-wm
#                                           with one of the kernel's UI self-tests
#                                           (wm, gfx, widgets) run before the desktop
#
# It's built 32-bit (-m32), like the EeePC's Linux will be: the kernel code
# keeps its 32-bit addresses. The generated files (fonts, icons, cursors, the
# build's defaults) and the disk image it opens come from the kernel's own
# Makefile, which this one runs first.

MAKEFLAGS += -r      # no built-in rules: they'd guess at the .d files

LBUILD ?= build-linux
KBUILD ?= build
SELFTEST ?=
EXTRA_APPS ?=
KERNEL_BUILD ?= 1
CC     := gcc
# LiteKern Go: ARCH_FLAGS= (empty) builds for the compiler's own CPU, 64-bit
# (x86_64 for the VM, aarch64 for the phone).
ARCH_FLAGS ?= -m32
CFLAGS := $(ARCH_FLAGS) -std=gnu11 -O2 -g -Wall -Wextra -Werror -fno-strict-aliasing \
          -Iplatform/include -I. -I$(KBUILD)/gen -DLKX_LINUX \
          -D_FILE_OFFSET_BITS=64 -D_TIME_BITS=64   # 32-bit, but big files and inodes (Windows drives)
LDFLAGS := $(ARCH_FLAGS)

# The kernel code that comes along unchanged.
KERNEL_C := appreg apps console cursor deflate desktop driver errno fat32 font gfx icon \
            inflate keymap lockscreen osk printk ramdisk screen screensaver settings sha256 \
            splash status storage sys_app text theme users wake wallpaper widget wm
# Generated by the kernel's Makefile (kernel/*.h describe them).
GEN_C := cursors icons uifont splash

# libk86.c is the apps' side (below), nsfb_lkx.c the browser's (linux/package/netsurf-lkx): not the shell's.
PLATFORM_C := $(filter-out platform/libk86.c platform/nsfb_lkx.c,$(wildcard platform/*.c))

# The apps (phase L2): each apps/<name>/ built as a Linux program,
# build-linux/apps/<name>/<name>, from its own sources and the SDK, as the
# kernel build makes apps/<name>/<name>.lkx. lkx-shell runs them.
APP_DIRS := $(wildcard apps/*) $(EXTRA_APPS)    # EXTRA_APPS: the tests' misbehaving apps
APP_SDK  := $(LBUILD)/sdk/sdk.o $(LBUILD)/platform/libk86.o \
            $(patsubst %,$(LBUILD)/kernel/%.o,gfx widget theme text inflate) $(LBUILD)/gen/uifont.o
APP_BINS := $(foreach p,$(APP_DIRS),$(LBUILD)/apps/$(notdir $(p))/$(notdir $(p)))
ifneq ($(SELFTEST),)
CFLAGS += -DLKX_SELFTEST_$(shell echo $(SELFTEST) | tr a-z A-Z)
TEST_C := tests/kernel/selftest_$(SELFTEST).c
endif
OBJS := $(patsubst %.c,$(LBUILD)/%.o,$(TEST_C)) \
        $(patsubst %,$(LBUILD)/kernel/%.o,$(KERNEL_C)) \
        $(patsubst %,$(LBUILD)/gen/%.o,$(GEN_C)) \
        $(patsubst platform/%.c,$(LBUILD)/platform/%.o,$(PLATFORM_C)) \
        $(LBUILD)/gen/vgafont.o

.PHONY: all run kernel-build clean
all: $(LBUILD)/lkx-shell $(APP_BINS)

define APP_RULE
$(LBUILD)/apps/$(notdir $(1))/%.o: $(1)/%.c | kernel-build
	@mkdir -p $$(dir $$@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $$@ $$<

$(LBUILD)/apps/$(notdir $(1))/$(notdir $(1)): $(patsubst $(1)/%.c,$(LBUILD)/apps/$(notdir $(1))/%.o,$(wildcard $(1)/*.c)) $(APP_SDK)
	$(CC) $(LDFLAGS) -o $$@ $$^
endef
$(foreach p,$(APP_DIRS),$(eval $(call APP_RULE,$(p))))

$(LBUILD)/sdk/%.o: sdk/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

# The kernel build makes the generated sources and the disk image.
# KERNEL_BUILD=0: it's been done (linux/build.sh, building for the EeePC
# with Buildroot's compiler, runs it with the host's first).
kernel-build:
ifneq ($(KERNEL_BUILD),0)
	@$(MAKE) -s BUILD=$(KBUILD) EXTRA_APPS= $(KBUILD)/litekernx.img   # never the tests' apps
endif

$(LBUILD)/lkx-shell: $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

$(LBUILD)/kernel/%.o: kernel/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/tests/%.o: tests/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/platform/%.o: platform/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/gen/%.o: $(KBUILD)/gen/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

# The console font: the VGA BIOS's 8x16, from QEMU's copy.
$(LBUILD)/gen/vgafont.c: platform/tools/vgafont.py
	@mkdir -p $(dir $@)
	python3 platform/tools/vgafont.py /usr/share/seabios/vgabios-stdvga.bin $@

$(LBUILD)/gen/vgafont.o: $(LBUILD)/gen/vgafont.c
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(LBUILD)/lkx-shell
	$(LBUILD)/lkx-shell

clean:
	rm -rf $(LBUILD)

-include $(OBJS:.o=.d) $(wildcard $(LBUILD)/apps/*/*.d $(LBUILD)/sdk/*.d $(LBUILD)/platform/libk86.d)
