# LiteKern X on Linux — lkx-shell, the desktop as a Linux program (phase L1).
#
#   wsl make -f platform/Makefile           build build-linux/lkx-shell
#   wsl make -f platform/Makefile run       open it in a window (WSLg)
#   wsl make -f platform/Makefile SELFTEST=wm LBUILD=build-linux/selftest-wm
#                                           with one of the kernel's UI self-tests
#                                           (wm, gfx, widgets) run before the desktop
#
# It's built 32-bit (-m32), like the EeePC's Linux will be: the kernel code
# keeps its 32-bit addresses. The generated files (fonts, icons, cursors, the
# build's defaults) and the disk image it opens come from the kernel's own
# Makefile, which this one runs first.

MAKEFLAGS += -r      # no built-in rules: they'd guess at the .d files

LBUILD ?= build-linux
KBUILD ?= build
SELFTEST ?=
CC     := gcc
CFLAGS := -m32 -std=gnu11 -O2 -g -Wall -Wextra -Werror -fno-strict-aliasing \
          -Iplatform/include -I. -I$(KBUILD)/gen -DLKX_LINUX \
          -D_FILE_OFFSET_BITS=64 -D_TIME_BITS=64   # 32-bit, but big files and inodes (Windows drives)
LDFLAGS := -m32

# The kernel code that comes along unchanged.
KERNEL_C := appreg apps console cursor deflate desktop driver errno fat32 font gfx icon \
            inflate keymap lockscreen printk ramdisk screen screensaver settings sha256 \
            splash status storage text theme users wake wallpaper widget wm
# Generated by the kernel's Makefile (kernel/*.h describe them).
GEN_C := cursors icons uifont splash

PLATFORM_C := $(wildcard platform/*.c)
ifneq ($(SELFTEST),)
CFLAGS += -DLKX_SELFTEST_$(shell echo $(SELFTEST) | tr a-z A-Z)
TEST_C := tests/kernel/selftest_$(SELFTEST).c
endif
OBJS := $(patsubst %.c,$(LBUILD)/%.o,$(TEST_C)) \
        $(patsubst %,$(LBUILD)/kernel/%.o,$(KERNEL_C)) \
        $(patsubst %,$(LBUILD)/gen/%.o,$(GEN_C)) \
        $(patsubst platform/%.c,$(LBUILD)/platform/%.o,$(PLATFORM_C)) \
        $(LBUILD)/gen/vgafont.o

.PHONY: all run kernel-build clean
all: $(LBUILD)/lkx-shell

# The kernel build makes the generated sources and the disk image.
kernel-build:
	@$(MAKE) -s BUILD=$(KBUILD) $(KBUILD)/litekernx.img

$(LBUILD)/lkx-shell: $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS)

$(LBUILD)/kernel/%.o: kernel/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/tests/%.o: tests/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/platform/%.o: platform/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

$(LBUILD)/gen/%.o: $(KBUILD)/gen/%.c | kernel-build
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

# The console font: the VGA BIOS's 8x16, from QEMU's copy.
$(LBUILD)/gen/vgafont.c: platform/tools/vgafont.py
	@mkdir -p $(dir $@)
	python3 platform/tools/vgafont.py /usr/share/seabios/vgabios-stdvga.bin $@

$(LBUILD)/gen/vgafont.o: $(LBUILD)/gen/vgafont.c
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(LBUILD)/lkx-shell
	$(LBUILD)/lkx-shell

clean:
	rm -rf $(LBUILD)

-include $(OBJS:.o=.d)
