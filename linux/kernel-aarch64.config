# LiteKern Go (the ARM build, phase 4) — on top of Linux's arm64 defconfig:
# what QEMU's virt machine needs (qemu-system-aarch64 -M virt -cpu
# cortex-a53: the phone's CPU). The phone itself gets the Nura samsung-a5
# kernel's own config later (ROADMAP.md, phase 6). Everything we use built
# in: no modules to load.

# Display: virtio-gpu (its 720x1280 mode, the phone's screen).
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_LOGO is not set
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y

# Input: virtio's keyboard and tablet (the touchscreen's stand-in), and USB HID.
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# The disk: virtio (the desktop reads its FAT32 partition and ramdisk itself).
CONFIG_VIRTIO_BLK=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Networking: virtio's Ethernet stands in for Wi-Fi; Wi-Fi's own stack for
# the tests' simulated radios.
CONFIG_VIRTIO_NET=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_MODULES=y
CONFIG_MAC80211_HWSIM=m
# CONFIG_MODULE_SIG is not set

# The serial port (the log, the tests): virt's PL011.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# What lkx-shell uses: memory files for windows (memfd), reading its apps'
# arguments safely (process_vm_readv), /dev made by the kernel.
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
# CONFIG_DEBUG_STACK_USAGE is not set
# The system is on the disk (its third partition).
CONFIG_EXT4_FS=y
