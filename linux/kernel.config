# LiteKern Go (the VM build) — on top of Linux's x86_64_defconfig: what the
# VMs need (VirtualBox, QEMU). The phone gets its own config from Nura's
# samsung-a5 kernel (ROADMAP.md, phase 6). Everything built in: no modules
# to load.

# Display: VirtualBox's VBoxSVGA (vboxvideo) and VMSVGA (vmwgfx); QEMU's
# standard VGA (bochs).
CONFIG_DRM=y
CONFIG_DRM_VBOXVIDEO=y
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_BOCHS=y
# QEMU's virtio-vga (linux/vm.sh): a hardware cursor, which QEMU's window
# shows as the PC's own pointer (no lag through WSL's display).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_LOGO is not set

# Memory: 64-bit, so all of it without HIGHMEM.
# Not "used greatest stack depth" in the Log for every program that ends.
# CONFIG_DEBUG_STACK_USAGE is not set

# Input: the VMs' PS/2 keyboard and USB tablet (the touchscreen's stand-in).
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# USB and disks: the VMs' controllers (the desktop reads its FAT32 partition
# and ramdisk itself).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Networking: the VMs' Intel Ethernet (e1000) stands in for Wi-Fi; Wi-Fi's
# own stack for the simulated radios below.
CONFIG_E1000=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# The VMs' ACPI: a battery (VirtualBox can show one), the power button.
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# What lkx-shell uses: memory files for windows (memfd), reading its apps'
# arguments safely (process_vm_readv), /dev made by the kernel.
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y

# CONFIG_MODULE_SIG is not set

# Networking's tests: a simulated Wi-Fi radio pair, as a module, loaded only
# by the tests (lkx-start, when the disk says so).
CONFIG_MODULES=y
CONFIG_MAC80211_HWSIM=m

# The boot screen (UI-PLAN.md): nothing of Linux's on the screen, the logo
# instead (kernel/splash.c). No "Decompressing Linux... Booting the kernel"
# from the decompressor; the messages go to the serial port only.
# CONFIG_X86_VERBOSE_BOOTUP is not set
# The VirtualBox VM starts the kernel straight from its EFI firmware
# (EFI/BOOT/BOOTX64.EFI, no bootloader, so no bootloader text either): its
# options are built in, and so is the system (an initramfs, linux/buildroot.defconfig).
# SYSLINUX's APPEND (BIOS machines, the QEMU tests) adds to these.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="quiet loglevel=3 console=ttyS0,115200 video=720x1280 vt.global_cursor_default=0"
