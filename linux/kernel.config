# LiteKern Go (the VM build) — on top of Linux's x86_64_defconfig. Still the
# Eee PC 1000HE's list from LiteKern X, plus VirtualBox's VMSVGA (vmwgfx).
# Everything built in: no modules to load.

# Display: the 945GSE's GMA 950 (i915); the VMs' (linux/vm.sh): QEMU's
# standard VGA (bochs), VirtualBox's VBoxSVGA (vboxvideo).
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_VBOXVIDEO=y
# VirtualBox's VMSVGA, the adapter it recommends for Linux guests.
CONFIG_DRM_VMWGFX=y
# QEMU's virtio-vga (linux/vm.sh): a hardware cursor, which QEMU's window
# shows as the PC's own pointer (no lag through WSL's display).
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_LOGO is not set

# Memory: 64-bit, so all of it without HIGHMEM.
# Not "used greatest stack depth" in the Log for every program that ends.
# CONFIG_DEBUG_STACK_USAGE is not set

# Input: the keyboard and touchpad (PS/2), USB mice and keyboards.
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
# The EeePC 1000HE's touchpad, with Linux's own driver: fingers and positions
# (platform/drm.c makes taps, moves and two-finger scrolling of them)
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# USB: the stick (the desktop reads its FAT32 partition and ramdisk itself).
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_MSDOS_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Networking (phase L5 uses it): the Atheros Ethernet (atl1e) and Wi-Fi
# (ath9k: no firmware file needed), QEMU's e1000.
CONFIG_NET_VENDOR_ATHEROS=y
CONFIG_ATL1E=y
CONFIG_ATL1C=y
CONFIG_E1000=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_RFKILL=y

# The Eee PC's own bits: its Fn keys and radios, the battery, the lid, heat.
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_EEEPC_LAPTOP=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_THERMAL=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# What lkx-shell uses: memory files for windows (memfd), reading its apps'
# arguments safely (process_vm_readv), /dev made by the kernel.
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y

# CONFIG_MODULE_SIG is not set

# Networking's tests: a simulated Wi-Fi radio pair, as a module, loaded only
# by the tests (lkx-start, when the stick says so): never on the EeePC itself.
CONFIG_MODULES=y
CONFIG_MAC80211_HWSIM=m
