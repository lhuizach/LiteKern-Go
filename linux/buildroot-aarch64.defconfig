# LiteKern Go — the system under the GUI for ARM (phase 4), built by Buildroot
# (LKX_ARCH=aarch64 bash linux/build.sh): the phone's CPU, a Cortex-A53, booted
# in qemu-system-aarch64 (linux/vm.sh qemu-arm). The VM's is buildroot.defconfig.
BR2_aarch64=y
BR2_cortex_a53=y

# The toolchain Buildroot builds itself: glibc.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

# Linux, from arm64's own default config plus what QEMU's virt machine needs
# (linux/kernel-aarch64.config). Its Image, the system built in.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LITEKERNX_PATH)/kernel-aarch64.config"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# The system: busybox's init and tools, /dev from devtmpfs (it follows
# hotplug: a USB mouse plugged in later appears by itself).
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_HOSTNAME="litekern-go"
BR2_TARGET_GENERIC_ISSUE="LiteKern Go"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
# lkx-shell, its apps and the start-up script: linux/overlay, and the
# compiled programs build.sh puts in output/lkx-overlay.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LITEKERNX_PATH)/overlay $(BASE_DIR)/lkx-overlay"

# The root filesystem: a compressed cpio, loaded into RAM at boot (initramfs).
# Nothing of the system is written to the stick while it runs.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# ... built into the kernel too, so the VM's EFI firmware can start it alone
# (linux/kernel.config): one file, EFI/BOOT/BOOTX64.EFI.
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# Networking (phase L5): Wi-Fi (wpa_supplicant, WPA2 and WPA3), the
# regulatory database, DHCP and time come from busybox (udhcpc, ntpd).
# hostapd only for the tests: a simulated access point (mac80211_hwsim).
# OpenSSL and the root certificates: WPA3 now, HTTPS in the browser (L6).
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_WPA3=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y

# busybox: Buildroot's config plus linux/busybox.fragment.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_LITEKERNX_PATH)/busybox.fragment"

# The browser (phase L6): NetSurf as a LiteKern X app (linux/package/netsurf-lkx),
# with curl for HTTP(S) and the DejaVu fonts.
BR2_PACKAGE_NETSURF_LKX=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_DEJAVU=y

# qemu-system-aarch64 for trying it on the PC (linux/vm.sh qemu-arm): built
# here, as WSL's own would need sudo.
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
