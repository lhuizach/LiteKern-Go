#!/bin/sh
# LiteKern X on Linux: start the desktop (from /etc/inittab).
#
# The desktop opens the stick it was booted from as its disk: the ramdisk
# (apps, wallpapers) at sector 4096 and the FAT32 partition (settings, users,
# files), as the kernel version did. USB disks can take a few seconds to
# appear, so it waits for the one whose sector 4096 starts "LKXR" (the Makefile's RAMDISK_LBA).

find_disk() {
    for d in /sys/block/sd* /sys/block/vd* /sys/block/hd*; do
        [ -e "$d" ] || continue
        dev=/dev/${d##*/}
        if [ "$(dd if="$dev" bs=512 skip=4096 count=1 2>/dev/null | head -c 4)" = "LKXR" ]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

# The log goes to the serial port when there is one (QEMU, the tests), else to
# a file in RAM (the phone: read it over ssh).
out=/tmp/lkx.log
for tty in /dev/ttyS0 /dev/ttyAMA0; do          # ARM's (QEMU's virt) is ttyAMA0
    if [ "$out" = /tmp/lkx.log ] && [ -e "$tty" ] && stty -F "$tty" 115200 >/dev/null 2>&1; then
        out=$tty
    fi
done

# The phone has no stick: its disk is a file in the system (linux/buildroot-phone.defconfig).
disk=
[ -f /usr/share/litekern/disk.img ] && disk=/usr/share/litekern/disk.img

# A phone that was flashed (phone/make-userdata.sh) has the disk on its storage instead: in the
# userdata partition, after the boot partition. Used from there, settings, Wi-Fi, the PIN and
# photos survive a restart; only its apps part (the ramdisk, sectors 4096 up to the FAT32 at
# 16384) is refreshed from the system's own copy at each start, because the apps come with the
# system. Every check has to pass: the data disk's mark, the ramdisk's mark, and the FAT32
# starting where it does in the system's copy. Nothing here ever formats, and nothing is
# written until they have; failing any of them, the RAM copy above is used as before.
DATA_START=133120           # sectors: where the data disk starts in userdata (phone/mkuserdata.py)
persistent_disk() {
    [ -f /usr/share/litekern/disk.img ] || return 1
    for p in /sys/class/block/mmcblk*p*; do
        [ -e "$p/uevent" ] || continue
        grep -qi '^PARTNAME=userdata$' "$p/uevent" || continue
        part=/dev/${p##*/}
        [ "$(dd if="$part" bs=512 skip=$DATA_START count=1 2>/dev/null | head -c 8)" = "LKGODATA" ] || { echo "lkx-start: $part has no data disk" > "$out"; return 1; }
        [ "$(dd if="$part" bs=512 skip=$((DATA_START + 4096)) count=1 2>/dev/null | head -c 4)" = "LKXR" ] || { echo "lkx-start: $part's data disk has no ramdisk" > "$out"; return 1; }
        # the FAT32's start (the partition table's second entry): the same as in the system's copy
        dd if="$part" bs=1 skip=$((DATA_START * 512 + 470)) count=4 of=/tmp/lk.a 2>/dev/null
        dd if=/usr/share/litekern/disk.img bs=1 skip=470 count=4 of=/tmp/lk.b 2>/dev/null
        cmp -s /tmp/lk.a /tmp/lk.b || { echo "lkx-start: $part's data disk has another layout" > "$out"; return 1; }
        loop=$(losetup -f 2>/dev/null) || return 1
        losetup -o $((DATA_START * 512)) "$loop" "$part" || return 1
        dd if=/usr/share/litekern/disk.img of="$loop" bs=512 skip=4096 seek=4096 count=12288 2>/dev/null
        echo "lkx-start: the disk is $loop, $part from sector $DATA_START" > "$out"
        persistent=$loop
        return 0
    done
    echo "lkx-start: no userdata partition found, the disk is the RAM copy" > "$out"
    return 1
}
persistent=
persistent_disk && disk=$persistent

# The extras area (phone/make-extras.sh, written with phone/update-system.sh --write extras): an ext4
# filesystem (label LKGO_EXTRAS) in userdata after the data disk, for big things that don't belong in the
# system image, like the web browser's sandbox. Mounted on /extras if it's there; if it isn't, or
# anything about it is wrong, nothing happens (never formatted or written here).
EXTRAS_START=4343808        # sectors; keep in step with phone/make-extras.sh
mount_extras() {
    for p in /sys/class/block/mmcblk*p*; do
        [ -e "$p/uevent" ] || continue
        grep -qi '^PARTNAME=userdata$' "$p/uevent" || continue
        part=/dev/${p##*/}
        eloop=$(losetup -f 2>/dev/null) || return 1
        losetup -o $((EXTRAS_START * 512)) "$eloop" "$part" || return 1
        if blkid "$eloop" 2>/dev/null | grep -q 'LABEL="LKGO_EXTRAS"'; then
            mkdir -p /extras
            if mount -t ext4 -o noatime "$eloop" /extras 2>/dev/null; then
                echo "lkx-start: extras mounted on /extras from $eloop" > "$out"
                return 0
            fi
            echo "lkx-start: the extras area didn't mount" > "$out"
        fi
        losetup -d "$eloop" 2>/dev/null
        return 1
    done
    return 1
}
[ -f /usr/share/litekern/disk.img ] && mount_extras
i=0
while [ -z "$disk" ] && [ $i -lt 100 ]; do
    disk=$(find_disk) || disk=
    [ -z "$disk" ] && { usleep 200000 2>/dev/null || sleep 1; }
    i=$((i + 1))
done
echo "lkx-start: disk ${disk:-not found} after $((i * 200)) ms" > "$out"
echo "lkx-start: system mounted $(grep -m1 " / " /proc/mounts | cut -d" " -f3,4 | cut -d, -f1)" > "$out"

# The time: lkx-shell reads the EeePC's clock in the time zone Settings chose
# (London unless changed: platform/machine.c), and sets it from the internet
# once connected (platform/net.c).
export LKX_APPS=/usr/lib/litekern
export LKX_TARGET=1
# The phone's USB network is its own (S45usbnet): a DHCP client on it would
# wipe the phone's address.
[ -f /usr/share/litekern/disk.img ] && export LKX_NET_SKIP=usb0

# Tests only (tests/linux/test-image.sh adds lkx.test=hwsim to the test copy's
# syslinux.cfg): two simulated Wi-Fi radios, an access point on the second
# ("LiteKern Test", WPA2, password "apple pie") handing out addresses, and the
# desktop told to leave that one alone: it sees one Wi-Fi card, wlan0.
if grep -q "lkx.test=hwsim" /proc/cmdline; then
    modprobe mac80211_hwsim radios=2
    i=0
    while [ ! -e /sys/class/net/wlan1 ] && [ $i -lt 50 ]; do usleep 100000; i=$((i + 1)); done
    cat > /tmp/hostapd.conf <<EOF
interface=wlan1
driver=nl80211
ssid=LiteKern Test
hw_mode=g
channel=6
wpa=2
wpa_passphrase=apple pie
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
EOF
    hostapd -B /tmp/hostapd.conf > "$out" 2>&1
    ip addr add 192.168.77.1/24 dev wlan1
    ip link set wlan1 up
    mkdir -p /var/lib/misc && touch /var/lib/misc/udhcpd.leases
    printf 'start 192.168.77.10\nend 192.168.77.50\ninterface wlan1\nopt router 192.168.77.1\nopt dns 192.168.77.1\n' > /tmp/udhcpd.conf
    udhcpd /tmp/udhcpd.conf
    echo "lkx-start: test Wi-Fi: an access point on wlan1" > "$out"
    export LKX_NET_SKIP=wlan1
fi
# The screen's driver may still be loading (the phone's, by eudev): wait for it.
w=0
while [ ! -e /dev/dri/card0 ] && [ $w -lt 150 ]; do
    usleep 200000 2>/dev/null || sleep 1
    w=$((w + 1))
done
echo "lkx-start: screen ready after $((w * 200)) ms" > "$out"
if [ -n "$disk" ]; then
    exec /usr/bin/lkx-shell --backend drm --disk "$disk" > "$out" 2>&1
fi
exec /usr/bin/lkx-shell --backend drm > "$out" 2>&1
